generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role          String   @default("admin")
  points        Int      @default(0)
  school        String   @default("")
  storeLocation String   @default("")
  created_at    DateTime @default(now())
  updated_at DateTime @updatedAt

  merchant_products MerchantProduct[]
  merchant_runs     MerchantInventory[]
  package_proposals PackageProposal[]
  orders            Order[]
  cart              Cart?
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id          String   @id @default(cuid())
  cart_id     String
  cart        Cart     @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  productId   String
  productType String
  productName String
  price       Float
  quantity    Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("cart_items")
}

model Stage {
  id         String      @id @default(cuid())
  name       String
  points     Int         @default(0)
  coverImage String      @default("")
  price      Float       @default(0)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  products   Product[]

  @@map("stages")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float?
  image     String   @default("")
  stage_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  stage     Stage    @relation(fields: [stage_id], references: [id], onDelete: Cascade)

  @@map("products")
}

model TeacherPackage {
  id              String          @id @default(cuid())
  name            String
  monthly_price   Float
  quarterly_price Float
  image           String   @default("")
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  features        TeacherFeature[]

  @@map("teacher_packages")
}

model TeacherFeature {
  id         String         @id @default(cuid())
  text       String
  package_id String
  created_at DateTime       @default(now())

  package    TeacherPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("teacher_features")
}

model PreorderProduct {
  id          String   @id @default(cuid())
  name        String
  price       Float
  image       String   @default("")
  description String   @default("")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("preorder_products")
}

model MerchantProduct {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Float    @default(0)
  stock       Int      @default(0)
  image       String   @default("")
  sku         String?  @unique
  vendor_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor      User     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("merchant_products")
}

model MerchantInventory {
  id            String   @id @default(cuid())
  merchant_id   String
  store_name    String   @default("")
  store_address String   @default("")
  phone         String   @default("")
  file_url      String
  file_name     String   @default("")
  status        String   @default("pending")
  created_at    DateTime @default(now())

  merchant      User     @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@map("merchant_inventories")
}

model PackageProposal {
  id              String   @id @default(cuid())
  teacher_name    String
  teacher_phone   String
  teacher_email   String   @default("")
  package_details String
  status          String   @default("pending")
  teacher_id      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  teacher         User     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("package_proposals")
}

model Order {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  source       String   // "stage", "preorder", "teacher_box"
  itemId       String
  itemName     String
  price        Float
  discount     Float    @default(0)
  pointsUsed   Int      @default(0)
  pointsEarned Int      @default(0)
  receiptImage String?

  status       String   @default("pending")
  trackingHistory Json?
  confirmedAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("orders")
}

model Notification {
  id           String   @id @default(cuid())
  product_id   String
  product_name String
  message      String   @default("")
  status       String   @default("active")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("notifications")
}

model Subscription {
  id                String   @id @default(cuid())
  package_id        String
  package_name      String   @default("")
  subscription_type String
  user_name         String
  address           String   @default("")
  phone             String
  sender_phone      String   @default("")
  receipt_image     String   @default("")
  status            String   @default("pending")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("subscriptions")
}
