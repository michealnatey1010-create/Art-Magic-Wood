generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("admin")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  merchant_products MerchantProduct[]
  package_proposals PackageProposal[]
}

model Stage {
  id         String      @id @default(cuid())
  name       String
  points     Int         @default(0)
  coverImage String      @default("")
  price      Float       @default(0)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  products   Product[]

  @@map("stages")
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float?
  image     String   @default("")
  stage_id  String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  stage     Stage    @relation(fields: [stage_id], references: [id], onDelete: Cascade)

  @@map("products")
}

model TeacherPackage {
  id              String          @id @default(cuid())
  name            String
  monthly_price   Float
  quarterly_price Float
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt

  features        TeacherFeature[]

  @@map("teacher_packages")
}

model TeacherFeature {
  id         String         @id @default(cuid())
  text       String
  package_id String
  created_at DateTime       @default(now())

  package    TeacherPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("teacher_features")
}

model PreorderProduct {
  id        String   @id @default(cuid())
  name      String
  price     Float
  image     String   @default("")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("preorder_products")
}

model Library {
  id         String   @id @default(cuid())
  name       String
  email      String
  commission Float    @default(10)
  active     Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("libraries")
}

model MerchantProduct {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  price       Float    @default(0)
  stock       Int      @default(0)
  image       String   @default("")
  sku         String?  @unique
  vendor_id   String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  vendor      User     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@map("merchant_products")
}

model PackageProposal {
  id              String   @id @default(cuid())
  teacher_name    String
  teacher_phone   String
  teacher_email   String   @default("")
  package_details String
  status          String   @default("pending")
  teacher_id      String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  teacher         User     @relation(fields: [teacher_id], references: [id], onDelete: Cascade)

  @@map("package_proposals")
}

model Order {
  id                 String   @id @default(cuid())
  customer_name      String
  customer_phone     String
  customer_address   String   @default("")
  payment_phone      String   @default("")
  payment_receipt    String   @default("")
  items              String   @default("[]")
  total_amount       Float    @default(0)
  status             String   @default("pending")
  notes              String   @default("")
  source             String   @default("")
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("orders")
}

model Notification {
  id           String   @id @default(cuid())
  product_id   String
  product_name String
  message      String   @default("")
  status       String   @default("active")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("notifications")
}
